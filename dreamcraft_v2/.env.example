SAGA_DB_PATH=./data/saga.db
SAGA_API_PORT=8002
SAGA_LOG_LEVEL=INFO

SAGA_LLM_ENDPOINT=http://llm.local:11434/v1
SAGA_LLM_MODEL=mistral
SAGA_LLM_TIMEOUT=120

SAGA_SIMULATION_BURST_ENABLED=true
SAGA_DECISION_WINDOW_START=01:00
SAGA_DECISION_WINDOW_END=04:00
SAGA_NARRATIVE_WINDOW_START=04:00
SAGA_NARRATIVE_WINDOW_END=06:00

SAGA_MAJOR_EVENT_THRESHOLD=7
SAGA_SQLITE_JOURNAL_MODE=WAL
SAGA_SQLITE_BUSY_TIMEOUT_MS=5000

SAGA_HOST_PORT=8002
