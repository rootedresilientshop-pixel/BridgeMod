<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Executable sample runner — not packaged to NuGet -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>10</LangVersion>
    <AssemblyName>Legacies_Bridge_Test</AssemblyName>
    <RootNamespace>BridgeMod.Bridge.Sample</RootNamespace>
  </PropertyGroup>

  <!-- Reference the BridgeMod.SDK library (project reference for local dev) -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\BridgeMod.SDK\BridgeMod.SDK.csproj" />
  </ItemGroup>

</Project>
