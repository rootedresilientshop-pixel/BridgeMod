<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Library output — no entry point -->
    <OutputType>Library</OutputType>
    <!-- net8.0 (LTS) + netstandard2.1 for broadest Unity/Mono compatibility -->
    <TargetFrameworks>net8.0;netstandard2.1</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>10</LangVersion>

    <!-- NuGet Package Metadata -->
    <PackageId>BridgeMod.SDK</PackageId>
    <Version>0.5.0</Version>
    <Authors>DreamCraft: Legacies Project</Authors>
    <Company>DreamCraft</Company>
    <Product>BridgeMod.SDK</Product>
    <Description>
      A security-first SDK for bridging PC modding toolchains with console game engines.
      Provides a three-gate validation firewall (Deserialize, Boundary Guards, Audit Logger)
      that sanitizes untrusted mod payloads before they reach the trusted console runtime.
    </Description>
    <PackageTags>audit-log;behavior-tree;bridge;console;console-ready;deterministic;dotnet;gamedev;middleware;modding;sdk;security;state-machine;unity;validation</PackageTags>
    <PackageReleaseNotes>
      v0.5.0 — Procedural Control Layer

      New Features:
      • BridgeRandom — Deterministic Xorshift32 PRNG with seed-based reproducibility
      • ProceduralWeightTable — Named weight normalization with BridgeConfig boundary guards
      • PROCEDURAL_GEN_001 audit code — Logs when BridgeRandom is initialized

      New Namespaces:
      • BridgeMod.Bridge.Procedural — Home for procedural generation types

      Quality:
      • 98/98 tests passing (85 existing + 13 Phase 4 procedural tests)
      • 0 compiler warnings in Release configuration
      • Determinism guarantee extended to procedural control layer
      • Backward compatible: all 85 pre-existing tests pass unmodified

      Design:
      • Xorshift32: pure bit-shifting, no platform libs, cross-runtime portable
      • Weight normalization: clamp via BridgeConfig, then divide by sum
      • Audit logging: optional BridgeRandom logger parameter for reproducibility tracking
    </PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/rootedresilientshop-pixel/BridgeMod</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/rootedresilientshop-pixel/BridgeMod</PackageProjectUrl>
    <Copyright>Copyright © 2024 DreamCraft: Legacies Project</Copyright>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Include README in the NuGet package (displayed on NuGet.org) -->
    <!-- README.md lives alongside this .csproj at src/BridgeMod.SDK/ -->
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- JSON serialization for audit log file export -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
