<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Library output — no entry point -->
    <OutputType>Library</OutputType>
    <!-- net8.0 (LTS) + netstandard2.1 for broadest Unity/Mono compatibility -->
    <TargetFrameworks>net8.0;netstandard2.1</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>10</LangVersion>

    <!-- NuGet Package Metadata -->
    <PackageId>BridgeMod.SDK</PackageId>
    <Version>0.6.0</Version>
    <Authors>DreamCraft: Legacies Project</Authors>
    <Company>DreamCraft</Company>
    <Product>BridgeMod.SDK</Product>
    <Description>
      Sovereign, deterministic modding engine with built-in governance manifest support.
      A security-first SDK for bridging PC modding toolchains with console game engines.
      Provides a three-gate validation firewall (Deserialize, Boundary Guards, Audit Logger)
      that sanitizes untrusted mod payloads. Features logic fingerprinting for visual orchestration
      in Thalamus and security auditing in Kanon. Fully deterministic across platforms.
    </Description>
    <PackageTags>modding;gamedev;security;sovereign-tech;determinism;unity;godot;dotnet;audit-log;behavior-tree;bridge;console;console-ready;middleware;sdk;state-machine;validation</PackageTags>
    <PackageReleaseNotes>
      v0.6.0 — Interface Alpha: Project Manifest &amp; Logic Fingerprinting

      New Features:
      • ProjectManifest — Security dashboard snapshot for Thalamus visual IDE
      • LogicFingerprint — SHA256 hash of all surfaces, weight tables, and behavior graphs
      • GovernanceCertificate — Property on ModBridge for Kanon governance integration
      • Governance Status Tracking — [UNGOVERNED], [PENDING_AUDIT], [GOVERNED_BY_KANON] prefixes on all audit log entries
      • GenerateLogicFingerprint() — Deterministic fingerprinting engine supporting surfaces, weight distributions, and behavior graph definitions
      • GenerateManifest() — Factory method to produce ProjectManifest with current governance state

      New Namespaces:
      • BridgeMod.Bridge.Models — ProjectManifest and GovernanceStatus enum

      Architecture:
      • Governance state is now tracked by ModBridge and reflected in all audit log entries
      • Logic fingerprint is deterministic across platforms (netstandard2.1 and net8.0 compatible)
      • Thalamus can now consume manifests as a "security dashboard"

      Quality:
      • 114/114 tests passing (100 existing + 14 new governance/fingerprint tests)
      • 0 compiler warnings in Release configuration
      • Backward compatible: all 100 pre-existing tests pass unmodified
      • Full support for console mod certification workflows

      Design:
      • Fingerprinting uses \x1F (Unit Separator) for deterministic hashing
      • Weight table fingerprinting uses raw "R" format doubles for platform independence
      • AuditLogger now tracks and reports governance status
    </PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/rootedresilientshop-pixel/BridgeMod</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/rootedresilientshop-pixel/BridgeMod</PackageProjectUrl>
    <Copyright>Copyright © 2024 DreamCraft: Legacies Project</Copyright>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Include README in the NuGet package (displayed on NuGet.org) -->
    <!-- README.md lives alongside this .csproj at src/BridgeMod.SDK/ -->
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- JSON serialization for audit log file export -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- System.Text.Json for netstandard2.1 compatibility (ModFactory deserialization) -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

</Project>
